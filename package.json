{
  "name": "@civ-clone/base-civil-war",
  "version": "0.0.0",
  "description": "A civil war for a rule set to use: when its rules say so, a civilization splits, and a new one takes some of its cities, their units and what it knows.",
  "repository": "git@github.com:civ-clone/base-civil-war.git",
  "keywords": [
    "typescript",
    "civilization"
  ],
  "author": "dom111 <dom111@users.noreply.github.com>",
  "license": "MIT",
  "private": false,
  "files": [
    "lib/**/*.ts",
    "lib/**/*.js",
    "lib/**/*.js.map",
    "Rules/**/*.ts",
    "Rules/**/*.js",
    "Rules/**/*.js.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run ts:compile && npm run prettier:format",
    "prettier:check": "prettier --config .prettierrc --check '**/*.ts'",
    "prettier:format": "prettier --config .prettierrc '**/*.ts' --write",
    "test": "ts-mocha ./tests/*.test.ts",
    "ts:compile": "tsc --build tsconfig.json"
  },
  "devDependencies": {
    "@types/chai": "^4.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^16.0.0",
    "chai": "^4.0.0",
    "mocha": "^10.0.0",
    "prettier": "^2.8.8",
    "ts-mocha": "^10.0.0",
    "typescript": "^4.0.0"
  },
  "dependencies": {
    "@civ-clone/base-game-end": "github:civ-clone/base-game-end#feat/m2e",
    "@civ-clone/base-player": "^0.1.2",
    "@civ-clone/core-city": "github:civ-clone/core-city#feat/m2e",
    "@civ-clone/core-civilization": "^0.1.9",
    "@civ-clone/core-game": "^0.1.17",
    "@civ-clone/core-player": "^0.1.10",
    "@civ-clone/core-rule": "^0.1.9",
    "@civ-clone/core-science": "^0.1.9",
    "@civ-clone/core-unit": "^0.1.32",
    "@civ-clone/core-world": "^0.1.24"
  }
}
